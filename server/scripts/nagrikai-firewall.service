[Unit]
Description=NagrikAI host firewall (rate-limit 22/80, drop other inbound)
After=network-pre.target
Before=network.target docker.service nagrikai.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/home/koiralas2/NagrikAI/server/scripts/vm-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
